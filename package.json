{
  "name": "rania-said-invitation",
  "private": true,
  "version": "1.0.0",
  "description": "Digital wedding invitation — عقد قران رانية & سعيد — 12/12/2026",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:florals": "node scripts/generate-florals.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/aref-ruqaa": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "framer-motion": "^14.12.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
